{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":configMigration"],
  "schedule": ["at any time"],
  "labels": ["dependency"],
  // images and actions pinned with digests
  "pinDigests": true,
  // Wait until required status checks pass before opening the PR (reduces noisy failing PRs)
  "prCreation": "not-pending",
  "minimumReleaseAgeBehaviour": "timestamp-optional", // transient updates do not have timestamps
  // Catch-all: every package waits 3 days after release before Renovate proposes an update.
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": { "enabled": true },
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "timezone": "Australia/Brisbane",
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,

  // Latest *stable* only — no beta, RC, alpha or preview, ever.
  "ignoreUnstable": true,
  "respectLatest": true,

  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 8am"],
  },

  // Frontend deps live in pnpm-lock.yaml; dedupe it after every update
  // the same way `pnpm install` would.
  "postUpdateOptions": ["pnpmDedupe"],

  // release-bump pushes a version commit to Renovate's PR branches. Without
  // this, Renovate treats the branch as hand-edited and stops rebasing it.
  // Must match the email in .github/workflows/release-bump.yaml.
  "gitIgnoredAuthors": ["339497082+automated-release[bot]@users.noreply.github.com"],

  "packageRules": [
    {
      // TypeScript 7's native/tsgo compiler drops the CJS `typescript.sys`
      // shape svelte-check relies on, so svelte-check breaks on it as of
      // 2026-08. Revisit once svelte-check declares stable TS7 support.
      "description": "Block TypeScript major updates to v7 until svelte-check supports it",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
    },
    {
      "description": "github-actions: group minor+patch together, run weekly",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "actions dependencies",
      "groupSlug": "actions-dependencies",
      "commitMessageTopic": "github-actions {{updateType}} dependencies",
      "schedule": ["before 8am on monday"],
    },
    {
      "matchManagers": ["cargo"],
      "matchDatasources": ["crate"],
      "groupName": "rust crates",
      "groupSlug": "rust-crates",
      "commitMessageTopic": "Rust crate {{depName}}",
      "commitMessageExtra": "({{newVersion}})",
      "matchUpdateTypes": ["minor", "patch"],
      "schedule": ["before 8am on monday"],
    },
    {
      "description": "Automerge anything that is NOT a major update",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest", "lockFileMaintenance"],
      "automerge": true,
      "platformAutomerge": false, // false to let renovate bot merge the PR instead of the GitHub UI automerge
      "automergeStrategy": "squash",
    },
    // Release labels (docs/RELEASE.md). The label rules below must stay
    // DISJOINT: `addLabels` accumulates across every matching rule, and a PR
    // with two semver labels (or none) fails release-check.
    //
    // Policy: only a MAJOR cargo/npm update cuts an app version, and only a
    // patch. Everything else ships with the next release without cutting one.
    //
    // Coverage, update type x manager (cargo/npm = "deps", others = "other"):
    //   deps  + major                                   -> rule 1 (patch)
    //   deps  + minor/patch/pin/digest/pinDigest/
    //           lockFileMaintenance/rollback/
    //           replacement/bump                        -> rule 2 (none)
    //   other + any update type (incl. major)           -> rule 3 (none)
    {
      "description": "Major cargo/npm updates cut a patch version of the app",
      "matchManagers": ["cargo", "npm"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["semver:uai-app:patch"],
    },
    {
      "description": "Every other cargo/npm update type cuts no version",
      "matchManagers": ["cargo", "npm"],
      "matchUpdateTypes": [
        "minor", "patch", "pin", "digest", "pinDigest", "lockFileMaintenance",
        "rollback", "replacement", "bump",
      ],
      "addLabels": ["semver:uai-app:none"],
    },
    {
      // Catch-all for every other manager (github-actions, docker, ...) and
      // every update type, majors included. Workflow pins live under
      // .github/**, which ships nothing.
      "description": "Updates from any other manager cut no version",
      "matchManagers": ["!cargo", "!npm"],
      "addLabels": ["semver:uai-app:none"],
    },
    {
      // No label here: this only changes how majors are handled.
      "description": "Major updates are never automerged and wait for Monday",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "schedule": ["before 8am on monday"],
    },
  ],
}
