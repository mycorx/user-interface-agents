<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Tauri merges this file into the macOS bundle's Info.plist. Without this
	     key macOS never shows the microphone permission prompt and silently
	     hands the app silence instead of audio. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>uia listens to your microphone so you can talk to the assistant.</string>
</dict>
</plist>
