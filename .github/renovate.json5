{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':configMigration',
  ],
  schedule: [
    'at any time',
  ],
  labels: [
    'dependency',
  ],
  pinDigests: true,
  prCreation: 'not-pending',
  minimumReleaseAgeBehaviour: 'timestamp-optional',
  minimumReleaseAge: '3 days',
  internalChecksFilter: 'strict',
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    enabled: true,
  },
  dependencyDashboard: {
    enabled: true,
    osvVulnerabilitySummary: 'all',
  },
  timezone: 'Australia/Brisbane',
  prConcurrentLimit: 5,
  ignoreUnstable: true,
  respectLatest: true,
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'before 8am',
    ],
  },
  postUpdateOptions: [
    'pnpmDedupe',
  ],
  gitIgnoredAuthors: [
    '339497082+automated-release[bot]@users.noreply.github.com',
  ],
  packageRules: [
    {
      description: 'Block TypeScript major updates to v7 until svelte-check supports it',
      matchPackageNames: [
        'typescript',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    {
      description: 'github-actions: group minor+patch together, run weekly',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'actions dependencies',
      groupSlug: 'actions-dependencies',
      commitMessageTopic: 'github-actions {{updateType}} dependencies',
      schedule: [
        'before 8am on monday',
      ],
    },
    {
      matchManagers: [
        'cargo',
      ],
      matchDatasources: [
        'crate',
      ],
      groupName: 'rust crates',
      groupSlug: 'rust-crates',
      commitMessageTopic: 'Rust crate {{depName}}',
      commitMessageExtra: '({{newVersion}})',
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      schedule: [
        'before 8am on monday',
      ],
    },
    {
      description: 'Automerge anything that is NOT a major update',
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
        'pinDigest',
        'lockFileMaintenance',
      ],
      automerge: true,
      platformAutomerge: false,
      automergeStrategy: 'squash',
    },
    {
      description: 'Major cargo/npm updates cut a patch version of the app',
      matchManagers: [
        'cargo',
        'npm',
      ],
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'semver:uia-app:patch',
      ],
    },
    {
      description: 'Every other cargo/npm update type cuts no version',
      matchManagers: [
        'cargo',
        'npm',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
        'pinDigest',
        'lockFileMaintenance',
        'rollback',
        'replacement',
        'bump',
      ],
      addLabels: [
        'semver:uia-app:none',
      ],
    },
    {
      description: 'Updates from any other manager cut no version',
      matchManagers: [
        '!cargo',
        '!npm',
      ],
      addLabels: [
        'semver:uia-app:none',
      ],
    },
    {
      description: 'Major updates are never automerged and wait for Monday',
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      schedule: [
        'before 8am on monday',
      ],
    },
  ],
}
