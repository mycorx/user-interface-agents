{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "uia",
  "version": "0.1.8",
  "identifier": "app.uia.voice",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm run kill-orphans && pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "features": ["desktop"]
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "hud",
        "title": "Assistant",
        "width": 420,
        "height": 220,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": false,
        "visible": true,
        "center": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["acrylic", "hudWindow"],
          "state": "active",
          "radius": 12
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["uia"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzRTQzRUI2NkRFNjlBNkMKUldSc211WnR0ajdrOC8rcm9ieWRTcGRGWW5VcE45TllZQkdLRUtFMkgzRjFwMVUyZWFtVWE1djEK",
      "endpoints": [
        "https://github.com/mycorx/user-interface-agents/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
